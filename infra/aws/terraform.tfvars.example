region = "us-east-1"
aws_profile = "afri-research"
ssh_public_key_path = "~/.ssh/afri-ai.pub"
admin_cidr = "YOUR_PUBLIC_IPV4/32"
node_count = 1
instance_type = "m7i.xlarge"
